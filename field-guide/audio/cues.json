 "caps": [
  {
   "kind": "obs",
   "n": 1,
   "t0": 0.7333333333333333,
   "t1": 3.066666666666667,
   "text": "It thinks before almost every reply.\nEven ‘hi’."
  },
  {
   "kind": "obs",
   "n": 2,
   "t0": 3.3,
   "t1": 5.266666666666667,
   "text": "Telling it not to think\ndoesn’t work."
  },
  {
   "kind": "tip",
   "n": 2,
   "t0": 4.866666666666666,
   "t1": 6.566666666666666,
   "text": "Lower the effort instead."
  },
  {
   "kind": "obs",
   "n": 3,
   "t0": 7.166666666666667,
   "t1": 9.4,
   "text": "Sometimes it stops\none plank short."
  },
  {
   "kind": "tip",
   "n": 3,
   "t0": 8.766666666666667,
   "t1": 10.7,
   "text": "“Avoid stopping while you still owe work.”"
  },
  {
   "kind": "obs",
   "n": 4,
   "t0": 10.966666666666667,
   "t1": 12.966666666666667,
   "text": "A {thumb} is not an approval."
  },
  {
   "kind": "tip",
   "n": 4,
   "t0": 12.4,
   "t1": 14.166666666666666,
   "text": "Say exactly what you approve."
  },
  {
   "kind": "obs",
   "n": 5,
   "t0": 14.4,
   "t1": 16.066666666666666,
   "text": "Tell it it owns the code…"
  },
  {
   "kind": "obs",
   "n": 5,
   "t0": 16.066666666666666,
   "t1": 17.766666666666666,
   "text": "…and it tidies EVERYTHING.",
   "cont": true
  },
  {
   "kind": "tip",
   "n": 5,
   "t0": 16.7,
   "t1": 18.766666666666666,
   "text": "Skip that line when you want small changes."
  },
  {
   "kind": "obs",
   "n": 6,
   "t0": 18.8,
   "t1": 20.766666666666666,
   "text": "On long tasks it goes quiet."
  },
  {
   "kind": "tip",
   "n": 6,
   "t0": 20.2,
   "t1": 22.766666666666666,
   "text": "“Every few tool calls, give the user a one-line update.”"
  },
  {
   "kind": "obs",
   "n": 7,
   "t0": 23.2,
   "t1": 25.4,
   "text": "At top effort it hires reviewers.\nItself."
  },
  {
   "kind": "tip",
   "n": 7,
   "t0": 24.866666666666667,
   "t1": 26.666666666666668,
   "text": "Tell it what subagents cost."
  },
  {
   "kind": "obs",
   "n": 8,
   "t0": 26.9,
   "t1": 29.466666666666665,
   "text": "Old rules pile up.\n‘Never’ means never."
  },
  {
   "kind": "tip",
   "n": 8,
   "t0": 29.266666666666666,
   "t1": 31.166666666666668,
   "text": "Trim old notes. Scope your rules."
  },
  {
   "kind": "obs",
   "n": 9,
   "t0": 31.366666666666667,
   "t1": 33.46666666666667,
   "text": "Its reports can get dense."
  },
  {
   "kind": "tip",
   "n": 9,
   "t0": 33.2,
   "t1": 35.166666666666664,
   "text": "“Write for an intelligent but low-context reader.”"
  },
  {
   "kind": "title",
   "n": 10,
   "t0": 36.7,
   "t1": 40,
   "text": "FABLE 5.2 — A FIELD GUIDE"
  },
  {
   "kind": "sub",
   "n": 10,
   "t0": 37.36666666666667,
   "t1": 40,
   "text": "Handle with clear instructions."
  }
 ],
