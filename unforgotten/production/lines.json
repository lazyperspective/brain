[{"id": "L01", "who": "sable_vo", "text": "Everything has a name.", "dur": 1.111, "env": "6865787435677644666678998877665665"}, {"id": "L02", "who": "sable_vo", "text": "A name is a promise... that something was here.", "dur": 2.474, "env": "689998899998876653223688877666664200000000012334568998545777766553357776664"}, {"id": "L03", "who": "mira", "text": "Sable! I wrote it! I wrote my name on the wall, just like you showed me!", "dur": 3.964, "env": "13688876568876554310000258756787777777542100000157756787777777777777777777766667777654321135422465235655677776324654442"}, {"id": "L04", "who": "sable", "text": "[chuckle] Then the wall will remember you. Even when I'm old and forgetful.", "dur": 4.151, "env": "54201453100001222210003799999876788999875457766677777777655534555555310000000136875789888888888899888765455531145457874211144"}, {"id": "L05", "who": "king", "text": "Hush now.", "dur": 0.748, "env": "79998888999999998776664"}, {"id": "L06", "who": "mira", "text": "Sable...?", "dur": 0.381, "env": "589997688753"}, {"id": "L07", "who": "sable", "text": "Mira, take my hand! Don't let go. Don't let go!", "dur": 3.555, "env": "57877665420000000014677435888876666666787520000000002699987778886323699988742000001479987778986325899988864"}, {"id": "L08", "who": "sable", "text": "No! Mira!", "dur": 1.185, "env": "578899988754210000000136778889999864"}, {"id": "L09", "who": "sable_vo", "text": "I don't remember her face anymore.", "dur": 1.398, "env": "577898778999975567642247998766677777776665"}, {"id": "L10", "who": "sable_vo", "text": "I remember that I swore.", "dur": 1.201, "env": "6876789998888766666567766776435788754"}, {"id": "L11", "who": "warden", "text": "The Storm Seed... it's gone!", "dur": 1.618, "env": "4664368999987655554443210000000014544422799887763"}, {"id": "L12", "who": "oren", "text": "The courier. Kaira was the last one in the vault. Find her!", "dur": 4.127, "env": "2222356654321000000000000000013467666544322222345422454556665553123566665443333211354310000000000000000000000258887776677763"}, {"id": "L13", "who": "kaira", "text": "[gasp] Okay. Okay. Framed, chased, and glowing. Great start to the week.", "dur": 4.517, "env": "7999633568876433210000000000279985446898863000269999999886553125667888875443221268986347888776654321000000025899742333698731356677777764"}, {"id": "L14", "who": "oren", "text": "Courier! Return the Seed!", "dur": 2.416, "env": "4557888877665421000000000000000257753135546777777767888877666666666655310"}, {"id": "L15", "who": "kaira", "text": "I don't HAVE it!", "dur": 0.796, "env": "687888754567774356532100"}, {"id": "L16", "who": "kaira", "text": "[sigh] Okay. I might have it.", "dur": 1.825, "env": "6998753100000026522467776531000000002589999743457753454"}, {"id": "L17", "who": "oren", "text": "Five days, courier. That's how long the elders give you before it tears you apart. Come quietly.", "dur": 6.445, "env": "67778876444689987654445421357876543100000000000000001589756666887766899877666664126888655666651157865445544565323567776411455688776555555541013565310000000000000000000000000146898774334678776432"}, {"id": "L18", "who": "kaira", "text": "Quiet's not really my thing.", "dur": 1.351, "env": "26899986335788875578888877775302566667764"}, {"id": "L19", "who": "tamo", "text": "Hey! That was the GOOD crate!", "dur": 1.595, "env": "688888876410000000258888876677557998533467877653"}, {"id": "L20", "who": "kaira", "text": "Sorry! Not sorry! You should run.", "dur": 1.776, "env": "479999987554310147985335788765532001577778767898776554"}, {"id": "L21", "who": "tamo", "text": "Run from wh-", "dur": 0.5, "env": "589998657988875"}, {"id": "L22", "who": "tamo", "text": "Three grown-ups... against one girl?", "dur": 2.144, "env": "37998657899877764113544310000001366679887644467898877766788888874"}, {"id": "L23", "who": "docker", "text": "Kid, that anchor hasn't moved in a hundred years", "dur": 2.699, "env": "357887420000000025887667887644666667875456777777765346777667776556544567765321111"}, {"id": "L24", "who": "tamo", "text": "That's not very fair... for you.", "dur": 1.868, "env": "686456899854678775311589888775310000000013788899999998763"}, {"id": "L25", "who": "kaira", "text": "Okay. Who ARE you?", "dur": 1.205, "env": "7853467653100000002698779998876765542"}, {"id": "L26", "who": "tamo", "text": "Tamo! I work here. Well. I did, until you landed on me.", "dur": 3.6, "env": "5898776532100000001578887789852124653200000000001356666663100000258876579998667654467666666677665556655555554"}, {"id": "L27", "who": "kaira", "text": "What is that?", "dur": 0.598, "env": "688875226999864100"}, {"id": "L28", "who": "tamo", "text": "Hollow. They took the lighthouse keeper last week. Nobody even remembers his name.", "dur": 4.132, "env": "6888776543100001589645885126888899877787665235532466667776554335776411100001478876777754566556777766777666665555545666655554"}, {"id": "L29", "who": "oren", "text": "No... not here. Not the harbor.", "dur": 2.502, "env": "5789998642100000000146789997543467777643100000000001468986225765557998633443"}, {"id": "L30", "who": "bellwether", "text": "The courier. And the anchor-bearer. Two of four.", "dur": 3.031, "env": "6656778777766554321000000001478898778998776664456654444322110000013567888877876554467766543"}, {"id": "L31", "who": "bellwether", "text": "[chuckle] The King will be so pleased.", "dur": 1.77, "env": "786665531000013334688777787677665568887665577776655433"}, {"id": "L32", "who": "tamo", "text": "Kaira! Whatever you've got, now would be a really good time!", "dur": 4.313, "env": "3689999988889999999999999998876531000247888899877887778763369998642122101357889999988776677545788776556899987764467742357877655432"}, {"id": "L33", "who": "kaira", "text": "I don't know how to use it!", "dur": 1.254, "env": "69999999999876788887678999973368741012"}, {"id": "L34", "who": "vesper", "text": "Step away from them.", "dur": 0.805, "env": "7864567899885335655666654"}]